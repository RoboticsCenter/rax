# Machine-local storage (a symlink to the data disk).
/runtime
/external
/local_tests/*
!/local_tests/unit/
!/local_tests/README.md
!/local_tests/goldens/

# Local orchestration state and caches.
/.agents
/.codex
/.dtach
/.pytest_cache
/.ruff_cache
/.local-runtime
**/__pycache__/
*.py[cod]
*.log

# IDE and OS metadata.
.DS_Store
.idea/
.vscode/
# Isolated local feature checkouts.
/.worktrees/
.venv/

# Hillclimb hook files
/.claude/settings.local.json
/.github/hooks/hooks.json
/.codex/hooks.json
/.claude/settings.local.json.malformed-*
/.github/hooks/hooks.json.malformed-*
/.codex/hooks.json.malformed-*

# MuJoCo writes warnings next to the process.
MUJOCO_LOG.TXT
