#!/usr/bin/env python3
"""Fit depth-to-color stereo geometry from saved paired ChArUco captures.

Uses training infrared/RGB corners only. Validates native depth against the
independently fitted base-frame board at every usable RGB view, including all
three reserved poses. No hardware access and no active calibration changes.
"""

import argparse
import json
import shutil
import sys
from pathlib import Path

import cv2 as cv
import numpy as np
from scipy.spatial.transform import Rotation

PROJECT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT))
from services.storage_root import artifact_root
from services.xarm.calibration import DepthRegistration
from services.xarm.charuco import detect_board, make_board


def error_statistics(errors):
    if not errors:
        raise ValueError('no valid depth samples for a calibration view')
    return {'median_mm': float(np.median(errors)),
            'p95_mm': float(np.quantile(errors, .95)), 'max_mm': max(errors)}


def fit(collection, fitroot, root):
    result = json.loads((fitroot / "result.json").read_text())
    if not result["ok"]:
        raise ValueError("RGB hand-eye fit must pass before stereo fitting")
    preflight = json.loads((collection / "preflight.json").read_text())
    for key in (
        "squares_x",
        "squares_y",
        "layout_squares_y",
        "square_m",
        "marker_m",
        "dictionary",
        "legacy_pattern",
    ):
        if preflight["board"].get(key) != result["board"].get(key):
            raise ValueError(
                "RGB fit and stereo collection must use the same board definition"
            )
    root.mkdir(parents=True, exist_ok=False)
    wrist = next(c["name"] for c in preflight["camera_specs"] if c["mount"] == "tcp")
    plans = {pose["index"]: pose for pose in preflight["poses"]}
    settings = result["board"]
    board, detector = make_board(settings)
    Kc = np.array(result["K"])
    Dc = np.array(result["distortion_coeffs"])
    samples = []
    for frame in json.loads((collection / "collection.json").read_text())["log"]:
        folder = Path(frame["frame_dir"])
        meta = json.loads((folder / "meta.json").read_text())
        e = meta["cameras"][wrist]
        n = e["native_calibration"]
        Ki = np.array(n["K"])
        Di = np.array(n["distortion_coeffs"])
        cp, ci, _, _ = detect_board(
            cv.imread(str(folder / e["rgb"]), 0), board, detector, settings
        )
        ip, ii, _, _ = detect_board(cv.imread(n["infrared"], 0), board, detector, settings)
        if ci is None:
            continue
        color = {int(i): p for i, p in zip(ci.ravel(), cp.reshape(-1, 2))}
        ir = (
            {} if ii is None else {int(i): p for i, p in zip(ii.ravel(), ip.reshape(-1, 2))}
        )
        shared = sorted(set(color) & set(ir))
        obj = board.getChessboardCorners()[shared].astype(np.float32).reshape(-1, 1, 3)
        samples.append(
            {
                "index": frame["index"],
                "held_out": plans[frame["index"]]["held_out"],
                "object": obj,
                "color": np.array([color[i] for i in shared], np.float32).reshape(-1, 1, 2),
                "ir": np.array([ir[i] for i in shared], np.float32).reshape(-1, 1, 2),
                "folder": folder,
                "entry": e,
                "native": n,
                "meta": meta,
                "all_ids": ci.ravel(),
                "all_color": cp.reshape(-1, 2),
            }
        )
    train = [s for s in samples if not s["held_out"] and len(s["object"]) >= 12]
    if len(train) < 9 or sum(s["held_out"] for s in samples) != 3:
        raise ValueError(
            "need at least nine paired training views and all three reserved RGB/depth views"
        )
    rms, _, _, _, _, R, t, _, _ = cv.stereoCalibrate(
        [s["object"] for s in train],
        [s["ir"] for s in train],
        [s["color"] for s in train],
        Ki.copy(),
        Di.copy(),
        Kc.copy(),
        Dc.copy(),
        (n["width"], n["height"]),
        flags=cv.CALIB_FIX_INTRINSIC,
        criteria=(cv.TERM_CRITERIA_EPS + cv.TERM_CRITERIA_MAX_ITER, 200, 1e-10),
    )
    T = np.eye(4)
    T[:3, :3] = R
    T[:3, 3] = t.ravel()
    metrics = []
    for s in samples:
        image = cv.imread(str(s["folder"] / s["entry"]["rgb"]), 0)
        shape = image.shape
        native = (
            cv.imread(s["native"]["depth"], cv.IMREAD_UNCHANGED)
            * s["native"]["depth_scale_m"]
        )
        registered = DepthRegistration(Ki, native.shape, Di, Kc, R, t.ravel(), shape).apply(
            native
        )
        pixels = cv.undistortPoints(s["all_color"].reshape(-1, 1, 2), Kc, Dc, P=Kc).reshape(
            -1, 2
        )
        worlderrors = []
        Tb = np.eye(4)
        Tb[:3, :3] = Rotation.from_quat(s["meta"]["tcp_quaternion"]).as_matrix()
        Tb[:3, 3] = s["meta"]["tcp_position"]
        basecam = Tb @ np.linalg.inv(np.array(result["T_cam_tcp"]))
        for ident, p in zip(s["all_ids"], pixels):
            x, y = np.rint(p).astype(int)
            if x < 2 or y < 2 or x >= shape[1] - 2 or y >= shape[0] - 2:
                continue
            patch = registered[y - 2 : y + 3, x - 2 : x + 3]
            valid = patch[patch > 0]
            if len(valid) < 3:
                continue
            z = float(np.median(valid))
            point = np.linalg.inv(Kc) @ np.r_[p, 1] * z
            base_actual = (basecam @ np.r_[point, 1])[:3]
            base_expected = (
                np.array(result["T_base_board"])
                @ np.r_[board.getChessboardCorners()[ident], 1]
            )[:3]
            worlderrors.append(float(np.linalg.norm(base_actual - base_expected) * 1000))

        metrics.append(
            {
                "index": s["index"],
                "held_out": s["held_out"],
                "common_corners": len(s["object"]),
                "valid_depth": len(worlderrors),
                "depth_vs_base_board": error_statistics(worlderrors),
            }
        )
    report = {
        "stereo_rms_px": rms,
        "T_color_depth": T.tolist(),
        "native_K": Ki.tolist(),
        "native_distortion_coeffs": Di.tolist(),
        "collection": str(collection),
        "rgb_fit": str(fitroot),
        "training_views": len(train),
        "held_out_views": 3,
        "metrics": metrics,
        "installed": False,
    }
    report["ok"] = rms < 1 and all(
        s["valid_depth"] >= 12
        and s["depth_vs_base_board"]["median_mm"] <= 5
        and s["depth_vs_base_board"]["p95_mm"] <= 10
        for s in metrics
    )
    (root / "result.json").write_text(json.dumps(report, indent=2) + "\n")
    if not report["ok"]:
        raise SystemExit("stereo or reserved depth checks failed; candidate not written")
    candidate = root / "candidate"
    shutil.copytree(fitroot / "candidate", candidate)
    p = candidate / f"{wrist}_intrinsics.json"
    reference = json.loads(p.read_text())
    reference["calibrated_depth_to_color"] = {
        "T_color_depth": report["T_color_depth"],
        "native_depth_profile": {
            "K": Ki.tolist(),
            "distortion_coeffs": Di.tolist(),
            "width": n["width"],
            "height": n["height"],
            "fps": e["fps"],
        },
        "method": "ChArUco infrared/RGB stereo with fixed intrinsic models; training views only",
        "source": str(root / "result.json"),
        "stereo_rms_px": rms,
        "validation": "Reserved depth checks passed; live MCP verification pending",
    }
    reference["validation"] = (
        "RGB hand-eye and reserved native-depth checks passed; live MCP verification pending"
    )
    reference["runtime_rectification"] = (
        "RGB rectified to fitted K; native depth projected through calibrated infrared-to-color transform into fitted color K"
    )
    p.write_text(json.dumps(reference, indent=2) + "\n")
    options = json.loads((fitroot / "backend-options.json").read_text())
    for camera in options["cameras"]:
        camera["intrinsics"] = str(candidate / Path(camera["intrinsics"]).name)
        camera["extrinsics"] = str(candidate / Path(camera["extrinsics"]).name)
        camera.pop("calibration_native", None)
        camera.pop("calibration_raw_color", None)
    (root / "backend-options.json").write_text(json.dumps(options, indent=2) + "\n")
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--collection', type=Path, required=True)
    parser.add_argument('--rgb-fit', type=Path, required=True)
    parser.add_argument('--root', type=Path, required=True)
    args = parser.parse_args()
    root = args.root.resolve()
    if not root.is_relative_to(artifact_root()):
        raise SystemExit('output root must be inside RAX_ARTIFACT_ROOT')
    report = fit(args.collection.resolve(), args.rgb_fit.resolve(), root)
    print(json.dumps(report, indent=2))


if __name__ == '__main__':
    main()
