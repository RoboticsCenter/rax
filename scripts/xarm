#!/usr/bin/env bash
# Short operator command for motion arming. Symlink it onto PATH, e.g. ~/.local/bin/xarm.
#   xarm ready           operator bring-up: clear errors, enable motion, set position mode
#   xarm arm [minutes]   arm the newest session (asks you to confirm the e-stop)
#   xarm disarm          disarm EVERY session and hold the arm
#   xarm status          arming state of recent sessions plus robot state when reachable
#   xarm requests        what the agent is asking the operator for
#   xarm reply [text]    answer the oldest open request ("done" for a reset)
#   xarm clean-streams   delete camera recordings of sessions that are not running
#   xarm home [--open]   move the arm to the xArm home pose; --open opens the gripper
set -euo pipefail
SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
PYTHON="${RAX_PYTHON:-$(command -v python3 || true)}"
[[ -x "$PYTHON" ]] || { echo "No robot Python: set RAX_PYTHON to the interpreter of the robot environment (got '$PYTHON')" >&2; exit 2; }
cd "$PROJECT_ROOT"
PYTHONPATH="$PROJECT_ROOT" exec "$PYTHON" - "$@" <<'PY'
import json, os, sys, time
from pathlib import Path

import numpy as np

from services.xarm import arming
from services.controller import operator
from services.storage_root import artifact_root
from services.xarm.backend import DEFAULTS, HOME_Q
from services.xarm.sdk import XArmDriver
from services.xarm.end_effectors import kind as effector_kind

sessions = sorted((p.parent for p in (artifact_root()/'sessions').glob('*/operator-input.json')),
                  key=lambda p: (p/'operator-input.json').stat().st_mtime)
action = sys.argv[1] if len(sys.argv) > 1 else 'status'


def ask(prompt):
    try:
        with open('/dev/tty', 'w') as out, open('/dev/tty') as tty:
            out.write(prompt)
            out.flush()
            return tty.readline().strip()
    except OSError:
        sys.exit('no terminal to confirm on')


def options():
    value = {}
    source = os.environ.get('RAX_BACKEND_OPTIONS')
    if source:
        value.update(json.loads(Path(source).read_text()))
    elif sessions:
        try:
            value.update(json.loads((sessions[-1]/'operator-input.json').read_text()).get('backend_options') or {})
        except Exception:
            pass
    return {**DEFAULTS, **value}


def driver():
    return XArmDriver(options())


def line(root):
    state = arming.read(root)
    extra = '' if not state.get('until') else f" until {time.strftime('%H:%M', time.localtime(state['until']))}"
    return f"{'ARMED   ' if state['armed'] else 'disarmed'}{extra}  {root.name}"


def alive(root):
    try:
        life = json.loads((root/'agent-lifecycle.json').read_text())
        os.kill(int(life['pid']), 0)
        return life.get('status') in ('preparing', 'running', 'usage_wait')
    except Exception:
        return False


if action == 'ready':
    from xarm.wrapper import XArmAPI
    opts = options()
    arm = XArmAPI(opts['xarm_ip'], is_radian=True)
    print(f"xArm SDK connected to {opts['xarm_ip']}")
    if ask('Person at the emergency stop and workspace clear? Type READY: ') != 'READY':
        sys.exit('not changed')
    for call, args in ((arm.clean_error, ()), (arm.clean_warn, ()), (arm.set_mode, (0,)),
                       (arm.set_state, (0,)), (arm.motion_enable, (True,)), (arm.set_state, (0,))):
        code = call(*args)
        if code != 0:
            sys.exit(f'{call.__name__} failed with xArm code {code}')
    if effector_kind(opts) != 'wuji_hand2' and hasattr(arm, 'set_gripper_enable'):
        arm.set_gripper_enable(True)
    print('xArm ready: errors clear, motion enabled, mode 0, state 0')
    arm.disconnect()
    if effector_kind(opts) == 'wuji_hand2':
        print('Prepare the hand separately through scripts/wuji prepare --session SESSION after arming.')
elif action == 'disarm':
    for root in sessions:
        if arming.read(root)['armed']:
            arming.write(root, False, reason='disarmed by the operator')
    from services.wuji.client import request, socket_path
    import uuid
    for root in sessions:
        if socket_path(root).exists():
            try:
                request(socket_path(root), 'emergency', id=uuid.uuid4().hex)
                print(f'{root.name}: hand stop queued; inspect scripts/wuji status for confirmation')
            except Exception as exc:
                print(f'{root.name}: hand stop request failed ({exc})')
    try:
        driver().hold()
        print('all sessions disarmed; arm holding')
    except Exception as exc:
        print(f'all sessions disarmed; hold failed ({exc})')
elif action == 'arm':
    if not sessions:
        sys.exit('no sessions')
    root = sessions[-1]
    minutes = float(sys.argv[2]) if len(sys.argv) > 2 else None
    print(f'session: {root.name}')
    if ask('Person at the emergency stop and workspace clear? Type ARM: ') != 'ARM':
        sys.exit('not armed')
    arming.write(root, True, minutes=minutes)
    print(line(root))
elif action == 'status':
    for root in sessions[-5:]:
        print(line(root))
        for request in operator.pending(root):
            print(f"   OPEN {request['kind'].upper()} {request['id']}: {request['message']}")
    try:
        state = driver().state()
        print('robot', {'tcp_position': np.round(state['tcp_position'], 4).tolist(),
                        'joints': np.round(state['joints'], 4).tolist(),
                        'state': state.get('state'), 'mode': state.get('mode'),
                        'error_code': state.get('error_code'), 'warn_code': state.get('warn_code')})
    except Exception as exc:
        print(f'robot unreachable: {exc}')
elif action == 'home':
    if '--open' in sys.argv[2:] and effector_kind(options()) == 'wuji_hand2':
        sys.exit('--open is for a gripper; use a commissioned Wuji posture through the session MCP tools')
    busy = [root.name for root in sessions if alive(root)]
    if busy:
        sys.exit(f'an agent session is running ({busy[0]}): stop it or use the agent; not homing')
    arm = driver()
    start = np.asarray(arm.state()['joints'])
    goal = np.asarray(HOME_Q)
    step = float(np.max(np.abs(goal - start)))
    seconds = max(4.0, step / 0.25)
    print('current', np.round(start, 3).tolist())
    print('home   ', np.round(goal, 3).tolist())
    print(f'largest joint change {step:.2f} rad, about {seconds:.0f} s')
    if step < 0.01:
        print('already home')
    elif ask('Person at the emergency stop and the swept volume clear? Type HOME: ') != 'HOME':
        sys.exit('not moved')
    else:
        arm.move_joints(goal, speed_radps=0.25, acc_radps2=0.8, timeout_s=seconds + 20)
        deadline = time.monotonic() + seconds + 20
        while time.monotonic() < deadline:
            error = float(np.max(np.abs(np.asarray(arm.state()['joints']) - goal)))
            if error < 0.02:
                print(f'home reached (largest joint error {error:.3f} rad)')
                break
            time.sleep(0.1)
        else:
            arm.hold()
            sys.exit('home timed out; arm hold requested')
    if '--open' in sys.argv[2:]:
        arm.gripper_move(arm.options['gripper_max_width_m'], speed=arm.options['gripper_speed'])
        print('gripper', arm.gripper_state())
elif action == 'clean-streams':
    import shutil
    for root in sessions:
        stream = root/'stream'
        if stream.is_dir() and any(stream.iterdir()) and not alive(root):
            size = sum(p.stat().st_size for p in stream.rglob('*') if p.is_file()) / 1e9
            shutil.rmtree(stream)
            stream.mkdir()
            print(f'deleted {size:.1f} GB  {root.name}')
elif action == 'snapshot-learning':
    if not sessions:
        sys.exit('no sessions')
    root = sessions[-1]
    label = sys.argv[2] if len(sys.argv) > 2 else 'manual'
    path = operator.snapshot_learning(root, label)
    print(f'saved learning snapshot {path}')
elif action in ('requests', 'reply'):
    open_requests = sorted(((r['created'], root, r) for root in sessions for r in operator.pending(root)),
                           key=lambda item: item[0])
    if not open_requests:
        sys.exit('no open requests')
    if action == 'requests':
        for _, root, r in open_requests:
            print(f"{r['kind'].upper():5s} {time.strftime('%H:%M:%S', time.localtime(r['created']))} {root.name}\n  {r['message']}")
    else:
        _, root, r = open_requests[0]
        text = ' '.join(sys.argv[2:]) or ('Scene reset done.' if r['kind'] == 'reset' else '')
        if not text:
            text = ask(f"{r['kind'].upper()}: {r['message']}\nYour answer: ")
        answer = operator.reply(root, r['id'], text, by='xarm-cli')
        print(f"answered {r['kind']} request {r['id']}")
        if answer.get('learning_snapshot'):
            print(f"saved learning snapshot {answer['learning_snapshot']}")
        elif answer.get('learning_snapshot_error'):
            print(f"learning snapshot failed: {answer['learning_snapshot_error']}")
else:
    sys.exit('usage: xarm ready | arm [minutes] | disarm | status | requests | reply [text] | '
             'snapshot-learning [label] | clean-streams | home [--open]')
PY
