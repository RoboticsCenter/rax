#!/usr/bin/env python3
"""Calibrate xArm RealSense extrinsics from a visible ChArUco board.

Preflight is read-only. Collection holds the measured hand posture, visits
bounded arm poses, and validates withheld poses before installing extrinsics.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
from pathlib import Path

PROJECT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT))
if os.environ.get("RAX_PYTHON") and Path(sys.executable).resolve() != Path(os.environ["RAX_PYTHON"]).resolve():
    os.execv(os.environ["RAX_PYTHON"], [os.environ["RAX_PYTHON"], *sys.argv])

import cv2 as cv
import numpy as np
from scipy.spatial.transform import Rotation, Slerp

from services.controller.config import Configuration
from services.storage_root import artifact_root
from services.xarm import arming
from services.xarm.backend import (
    DEFAULTS,
    CameraService,
    XArmBackend,
)
from services.xarm.charuco import (
    board_settings,
    charuco_pose,
    detect_small_board,
    fit_fixed_camera,
    fit_report,
    invert,
    make_board,
    mat_from_pose,
    quality_ok,
    solve_hand_eye,
    write_matrix,
)
from services.xarm.sdk import XArmDriver


def capture(service, root, names, arm):
    before = arm.state()
    folder = root/'frames'/str(time.time_ns())
    entries = service.request({'op': 'grab', 'cameras': names, 'depth': False,
                               'out_dir': str(folder)})['cameras']
    after = arm.state()
    movement = float(np.linalg.norm(after['tcp_position']-before['tcp_position']))
    turn = float((Rotation.from_quat(after['tcp_quaternion']) *
                  Rotation.from_quat(before['tcp_quaternion']).inv()).magnitude())
    if movement > .0002 or turn > np.radians(.1):
        raise RuntimeError('arm moved during calibration capture')
    meta = {'calibration_pending': True, 'tcp_position': after['tcp_position'].tolist(),
            'tcp_quaternion': after['tcp_quaternion'].tolist(), 'cameras': {
                n: {**e, 'rgb': Path(e['rgb']).name} for n, e in entries.items()}}
    (folder/'meta.json').write_text(json.dumps(meta, indent=2)+'\n')
    return folder, meta


def pose_plan(p0, q0):
    # Excite multiple rotation axes. Last three poses are withheld from fitting.
    offsets = [
        ([0, 0, 0], [0, 0, 0]),
        ([0, 0, .025], [15, 0, 0]),
        ([0, 0, .025], [-15, 0, 0]),
        ([0, 0, .025], [0, 15, 0]),
        ([0, 0, .025], [0, -15, 0]),
        ([0, 0, .025], [0, 0, 20]),
        ([0, 0, .025], [0, 0, -20]),
        ([.025, 0, .035], [10, 10, 10]),
        ([-.025, 0, .035], [-10, -10, -10]),
        ([0, .025, .035], [10, -10, 10]),
        ([0, -.025, .035], [-10, 10, -10]),
        ([.02, .02, .045], [0, 15, -15]),
        ([-.02, -.02, .045], [0, -15, 15]),
        ([0, 0, .05], [15, 0, -10]),
        ([0, 0, .015], [-15, 0, 10]),
        ([.015, -.015, .03], [8, -12, 6]),
        ([-.015, .015, .04], [-8, 12, -6]),
        ([0, 0, .02], [7, 7, -12]),
    ]
    rotation = Rotation.from_quat(q0)
    return [{'index': i, 'position': (p0+dp).tolist(),
             'quaternion': (rotation*Rotation.from_euler('xyz', angles, degrees=True)).as_quat().tolist(),
             'translation_delta_m': dp, 'rotation_delta_deg': angles,
             'held_out': i >= len(offsets)-3} for i, (dp, angles) in enumerate(offsets)]


def bounded_transitions(start_position, start_quaternion, goal, max_translation_m):
    """Retain capture poses while leaving margin beneath the per-command limit."""
    if not np.isfinite(max_translation_m) or max_translation_m <= 0:
        raise ValueError('max_translation_m must be finite and positive')
    start = np.asarray(start_position, dtype=float)
    finish = np.asarray(goal['position'], dtype=float)
    count = max(1, int(np.ceil(np.linalg.norm(finish-start)/(0.8*max_translation_m))))
    turns = Slerp([0., 1.], Rotation.from_quat([start_quaternion, goal['quaternion']]))
    return [{'position': (start+(finish-start)*fraction).tolist(),
             'quaternion': turns(fraction).as_quat().tolist()}
            for fraction in np.linspace(0., 1., count+1)[1:]]


def motion_plan(plan, state, opts):
    previous, rotation = state['tcp_position'], state['tcp_quaternion']
    expanded = []
    destinations = [*plan, {'index': 'return', 'position': list(previous), 'quaternion': list(rotation)}]
    for goal in destinations:
        steps = bounded_transitions(previous, rotation, goal, opts['max_translation_m'])
        expanded.extend({**step, 'capture_index': goal['index'], 'final_step': i == len(steps)-1}
                        for i, step in enumerate(steps))
        previous, rotation = goal['position'], goal['quaternion']
    return expanded


def validate_plan(plan, state, arm, opts):
    previous = np.asarray(state['tcp_position'])
    for pose in motion_plan(plan, state, opts):
        position = np.asarray(pose['position'])
        if np.any(position < opts['workspace_min']) or np.any(position > opts['workspace_max']):
            raise ValueError(f"pose {pose['capture_index']} is outside the workspace")
        if np.linalg.norm(position-previous) > opts['max_translation_m']:
            raise ValueError('calibration step exceeds the configured translation limit')
        problem = arm.check_tcp_limit(position, pose['quaternion'])
        if problem:
            raise ValueError(f"pose {pose['capture_index']}: {problem}")
        previous = position


def wait_hand(hand, timeout=15, prepared=False):
    deadline = time.monotonic()+timeout
    while time.monotonic() < deadline:
        state = hand.status()
        if (state.get('fresh') and not state.get('fault') and not state.get('faults')
                and (not prepared or (state.get('enabled') and state.get('mode') == 'holding'))):
            return state
        time.sleep(.05)
    raise RuntimeError('Wuji did not produce the required fresh feedback before the deadline')


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--backend-options', type=Path, default=PROJECT/'examples/xarm-wuji.json')
    parser.add_argument('--board', type=Path, default=PROJECT/'calibration/xarm-wuji/board.json')
    parser.add_argument('--calibration-dir', type=Path, default=PROJECT/'calibration/xarm-wuji')
    parser.add_argument('--root', type=Path, required=True, help='new artifact directory')
    parser.add_argument('--preflight', action='store_true', help='read-only pose and camera checks')
    parser.add_argument('--yes', action='store_true', help='operator authorizes the displayed calibration motion')
    parser.add_argument('--prepare-hand', action='store_true', help='operator authorizes holding the measured finger posture')
    parser.add_argument('--capture-native', action='store_true', help='also save synchronized wrist infrared and native depth for stereo calibration')
    parser.add_argument('--use-installed-intrinsics', action='store_true',
                        help='refit extrinsics using the existing color models, preserving depth alignment')
    parser.add_argument('--install', action='store_true', help='install extrinsics only if fit and held-out checks pass')
    parser.add_argument('--width', type=int, default=1280)
    parser.add_argument('--height', type=int, default=720)
    return parser.parse_args()


def main():
    args = parse_args()
    if args.use_installed_intrinsics and args.capture_native:
        raise SystemExit('--capture-native requires raw color; omit --use-installed-intrinsics for stereo collections')
    if not args.preflight and not args.yes:
        raise SystemExit('Use --preflight first; --yes authorizes robot motion.')
    root = args.root.resolve()
    if not root.is_relative_to(artifact_root()):
        raise SystemExit(f'root must be under {artifact_root()}')
    root.mkdir(parents=True, exist_ok=False)
    overlays = root/'overlays'
    overlays.mkdir()
    opts = {**DEFAULTS, **json.loads(args.backend_options.read_text())}
    if args.install and not args.use_installed_intrinsics and any(
            spec.get('intrinsics') and json.loads(Path(spec['intrinsics']).read_text()).get('calibrated_color_profiles')
            for spec in opts['cameras']):
        raise ValueError('raw collection cannot install extrinsics beside an existing fitted color model; '
                         'fit and verify a complete candidate instead')
    names = [s['name'] for s in opts['cameras']]
    wrists = [s['name'] for s in opts['cameras'] if s['mount'] == 'tcp']
    fixed_names = [s['name'] for s in opts['cameras'] if s['mount'] == 'fixed']
    if len(wrists) != 1 or not fixed_names or len(names) != len(set(names)):
        raise ValueError('need exactly one TCP camera and at least one fixed camera with unique names')
    wrist = wrists[0]
    has_hand = (opts.get('end_effector') or {}).get('type') == 'wuji_hand2'
    if has_hand and not args.preflight and not args.prepare_hand:
        raise SystemExit('Wuji collection requires --prepare-hand to hold the measured finger posture.')
    opts.update(stream_enabled=False, motion_archive_enabled=False, stream_archive=False,
                cartesian_speed_mps=.015, cartesian_acc_mps2=.05)
    for spec in opts['cameras']:
        spec.update(width=args.width, height=args.height,
                    calibration_raw_color=not args.use_installed_intrinsics)
        if args.capture_native and spec['mount'] == 'tcp':
            spec['calibration_native'] = True
    settings = board_settings(args)
    board, detector = make_board(settings)
    service = CameraService(opts, root/'frames', root/'camera-server.log', 'NONE')
    arm = None
    backend = None
    samples, log = [], []
    result_path = root/'result.json'
    def detections(folder):
        found = {name: charuco_pose(folder, name, board, detector, overlay_dir=overlays, settings=settings)
                 for name in names}
        if any(c.get('calibration_native') for c in opts['cameras']):
            metadata = json.loads((folder/'meta.json').read_text())
            for name, entry in metadata['cameras'].items():
                if 'native_calibration' in entry:
                    image = cv.imread(entry['native_calibration']['infrared'], cv.IMREAD_GRAYSCALE)
                    _, ids, _, _ = detect_small_board(image, board, detector, settings)
                    found[name][1]['infrared_corners'] = 0 if ids is None else len(ids)
        return found
    try:
        arm = XArmDriver(opts)
        start = arm.state()
        p0, q0 = start['tcp_position'], start['tcp_quaternion']
        plan = pose_plan(p0, q0)
        validate_plan(plan, start, arm, opts)
        service.start()
        time.sleep(8 if any(c.get('calibration_native') for c in opts['cameras']) else 3)
        folder, _ = capture(service, root, names, arm)
        found = detections(folder)
        visible = {name: {'usable': pose is not None and d['charuco_corners'] >= 12
                          and d.get('reprojection_mean_px', 99) < 1.
                          and d.get('infrared_corners', 12) >= 12, **d} for name, (pose, d) in found.items()}
        preflight = {'ok': all(d['usable'] for d in visible.values()), 'board': settings,
                     'cameras': visible, 'camera_specs': opts['cameras'], 'poses': plan,
                     'motion_steps': motion_plan(plan, start, opts),
                     'start_position': p0.tolist(), 'start_quaternion': q0.tolist(),
                     'arm_state': start['state'], 'arm_mode': arm.arm.mode, 'arm_error': start['error_code'],
                     'tcp_offset_mm_rad': list(arm.arm.tcp_offset), 'tcp_load': arm.arm.tcp_load,
                     'speed_mps': opts['cartesian_speed_mps'], 'initial_frame': str(folder)}
        (root/'preflight.json').write_text(json.dumps(preflight, indent=2)+'\n')
        print(json.dumps({'preflight': preflight}), flush=True)
        if not preflight['ok']:
            raise RuntimeError('board visibility/reprojection check failed before motion')
        if args.preflight:
            return
        if start['state'] not in (0, 2) or start['error_code'] or arm.arm.mode != 0:
            raise RuntimeError('arm must be ready/idle in position mode; operator ready is required')
        config = Configuration(root=root, task='camera_calibration', robot='xarm',
                               backend_options=opts, observation_profile='rgb-only')
        (root/'operator-input.json').write_text(json.dumps(config.to_dict(), indent=2)+'\n')
        backend = XArmBackend(config, arm=arm, cameras=service, camera_models={})
        if has_hand:
            wait_hand(backend.end_effector)
        arming.write(root, True, minutes=15, by='camera-calibration-operator')
        if has_hand:
            from services.wuji.client import operation
            print(json.dumps({'prepared': operation(root, 'prepare', timeout=15)}), flush=True)
            wait_hand(backend.end_effector, prepared=True)
        def move_to(goal):
            current = arm.state()
            steps = bounded_transitions(current['tcp_position'], current['tcp_quaternion'],
                                        goal, opts['max_translation_m'])
            for step in steps:
                backend.call('xarm_move_pose', {**step, 'tolerance_mm': 1, 'timeout_s': 20})

        for goal in plan:
            move_to(goal)
            time.sleep(.8)
            folder, meta = capture(service, root, names, arm)
            found = detections(folder)
            pose, detection = found[wrist]
            entry = {'index': goal['index'], 'frame_dir': str(folder),
                     'detections': {n: d for n, (_, d) in found.items()}, 'accepted': False}
            if (pose is not None and detection['charuco_corners'] >= 12
                    and detection['reprojection_mean_px'] < 1):
                entry['accepted'] = True
                samples.append({'index': goal['index'], 'held_out': goal['held_out'],
                                'T_base_tcp': mat_from_pose(meta['tcp_position'], meta['tcp_quaternion']),
                                'T_cam_board': pose, 'detection': detection,
                                'fixed': {n: p for n, (p, d) in found.items() if n in fixed_names and p is not None
                                          and d['charuco_corners'] >= 12 and d['reprojection_mean_px'] < 1}})
            log.append(entry)
            from services.json_io import jsonable
            (root/'collection.json').write_text(json.dumps(jsonable({'samples': samples, 'log': log}), indent=2)+'\n')
            print(json.dumps(entry), flush=True)
        move_to({'position': p0.tolist(), 'quaternion': q0.tolist()})
    except BaseException as exc:
        result_path.write_text(json.dumps({'ok': False, 'reason': str(exc), 'log': log}, indent=2)+'\n')
        raise
    finally:
        if backend is not None:
            arming.write(root, False, reason='calibration collection finished')
            try:
                print(json.dumps({'stop': backend.call('xarm_hold', {})[0]}), flush=True)
            finally:
                backend.close()
        else:
            service.close()
            if arm is not None:
                arm.close()
    training = [s for s in samples if not s['held_out']]
    held_out = [s for s in samples if s['held_out']]
    if len(training) < 9 or len(held_out) != 3:
        result_path.write_text(json.dumps({'ok': False, 'reason': 'need at least 9 fitting and all 3 held-out poses', 'log': log}, indent=2)+'\n')
        raise SystemExit('insufficient accepted poses; no extrinsics installed')
    T_tcp_cam, T_base_board = solve_hand_eye(training)
    residuals = fit_report(T_tcp_cam, T_base_board, samples)
    fixed = {}
    for name in fixed_names:
        observations = [s['fixed'][name] for s in samples if name in s['fixed']]
        fixed[name] = fit_fixed_camera(observations, T_base_board)
    T_cam_tcp = invert(T_tcp_cam)
    offset = preflight['tcp_offset_mm_rad']
    T_flange_tcp = mat_from_pose(np.asarray(offset[:3])/1000., Rotation.from_euler('xyz', offset[3:]).as_quat())
    result = {'ok': quality_ok(residuals) and all(f['ok'] for f in fixed.values()),
              'T_cam_tcp': T_cam_tcp.tolist(), 'T_cam_flange': (T_cam_tcp@invert(T_flange_tcp)).tolist(),
              'T_base_board': T_base_board.tolist(), 'residuals': residuals, 'fixed': fixed,
              'preflight': preflight, 'installed': False, 'log': log}
    result_path.write_text(json.dumps(result, indent=2)+'\n')
    if not result['ok']:
        raise SystemExit('fit, held-out or stationary-board check exceeded 5 mm / 1 degree; no extrinsics installed')
    if args.install:
        source = {'method': 'ChArUco with held-out validation', 'result': str(result_path), 'board': settings,
                  'tcp_offset_mm_rad': offset, 'camera_specs': opts['cameras'], 'quality_check_passed': True}
        write_matrix(args.calibration_dir/f'{wrist}_T_cam_tcp.yaml', T_cam_tcp, source)
        write_matrix(args.calibration_dir/f'{wrist}_T_cam_flange.yaml', result['T_cam_flange'], source)
        for name, value in fixed.items():
            write_matrix(args.calibration_dir/f'{name}_T_cam_base.yaml', value['T_cam_base'], source)
        result['installed'] = True
        result_path.write_text(json.dumps(result, indent=2)+'\n')
    print(json.dumps(result, indent=2))


if __name__ == '__main__':
    main()
