#!/usr/bin/env python3
"""Fit wrist color intrinsics and assembly extrinsics from saved raw captures.

No hardware access. Writes a candidate configuration only when training,
held-out and fixed-camera checks pass. Verify its normal RGB-D observations
before copying the candidate files into the active calibration directory.
"""
import argparse
import copy
import json
import sys
from pathlib import Path

PROJECT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT))

import cv2 as cv
import numpy as np
from scipy.spatial.transform import Rotation

from services.storage_root import artifact_root
from services.xarm import charuco as geometry
from services.xarm.charuco import detect_board, make_board


def fit(collection, root, options):
    preflight = json.loads((collection/'preflight.json').read_text())
    captured = json.loads((collection/'collection.json').read_text())
    settings = preflight['board']
    board, detector = make_board(settings)
    wrist = next(c['name'] for c in preflight['camera_specs'] if c['mount'] == 'tcp')
    plans = {p['index']: p for p in preflight['poses']}
    frames = {entry['index']: Path(entry['frame_dir']) for entry in captured['log']}
    samples = []
    for original in captured['samples']:
        folder = frames[original['index']]
        meta = json.loads((folder/'meta.json').read_text())
        entry = meta['cameras'][wrist]
        if entry.get('intrinsics_source', 'realsense_factory') != 'realsense_factory':
            raise ValueError('intrinsics fitting requires raw factory-profile images, not rectified images')
        corners, ids, _, _ = detect_board(cv.imread(str(folder/entry['rgb']), 0), board, detector, settings)
        if ids is None or len(ids) < 12 or board.checkCharucoCornersCollinear(ids):
            raise ValueError(f"saved accepted pose {original['index']} cannot be redetected")
        obj, img = board.matchImagePoints(corners, ids)
        fixed_poses = {}
        for camera in [c for c in preflight['camera_specs'] if c['mount'] == 'fixed']:
            pose, detection = geometry.charuco_pose(folder, camera['name'], board, detector, settings=settings)
            if (pose is not None and detection['charuco_corners'] >= 12
                    and detection['reprojection_mean_px'] < 1):
                fixed_poses[camera['name']] = pose
        samples.append({**original, 'held_out': plans[original['index']]['held_out'],
                        'T_base_tcp': np.asarray(original['T_base_tcp']),
                        'fixed': fixed_poses,
                        'obj': np.asarray(obj, np.float32), 'img': np.asarray(img, np.float32)})
    training = [s for s in samples if not s['held_out']]
    if len(training) < 9 or sum(s['held_out'] for s in samples) != 3:
        raise ValueError('need at least nine training views and all three reserved views')
    factory = np.asarray(entry['K'], float)
    rms, K, D, _, _ = cv.calibrateCamera(
        [s['obj'] for s in training], [s['img'] for s in training],
        (entry['width'], entry['height']), factory.copy(), np.zeros(5),
        flags=cv.CALIB_USE_INTRINSIC_GUESS)
    if (not np.isfinite(K).all() or not np.isfinite(D).all() or rms > 1
            or not .8 < K[0, 0]/factory[0, 0] < 1.2
            or not .8 < K[1, 1]/factory[1, 1] < 1.2
            or not 0 < K[0, 2] < entry['width'] or not 0 < K[1, 2] < entry['height']):
        raise ValueError('intrinsic fit failed reprojection or plausibility bounds')
    for sample in samples:
        ok, rvec, tvec = cv.solvePnP(sample['obj'], sample['img'], K, D)
        if not ok:
            raise ValueError('PnP failed with fitted intrinsics')
        projected, _ = cv.projectPoints(sample['obj'], rvec, tvec, K, D)
        errors = np.linalg.norm(projected.reshape(-1, 2)-sample['img'].reshape(-1, 2), axis=1)
        sample['T_cam_board'] = geometry.mat_from_pose(
            tvec.ravel(), Rotation.from_rotvec(rvec.ravel()).as_quat())
        sample['detection'] = {'charuco_corners': len(sample['obj']),
                               'reprojection_mean_px': float(errors.mean()),
                               'reprojection_max_px': float(errors.max())}
    X, B = geometry.solve_hand_eye([s for s in samples if not s['held_out']])
    residuals = geometry.fit_report(X, B, samples)
    fixed = {}
    for camera in [c for c in preflight['camera_specs'] if c['mount'] == 'fixed']:
        name = camera['name']
        observations = [np.asarray(s['fixed'][name]) for s in samples if name in s['fixed']]
        if len(observations) < 6:
            raise ValueError(f'{name}: need six fixed-camera views')
        fixed[name] = geometry.fit_fixed_camera(observations, B)
    offset = preflight['tcp_offset_mm_rad']
    F = geometry.mat_from_pose(np.asarray(offset[:3])/1000., Rotation.from_euler('xyz', offset[3:]).as_quat())
    cam_tcp = geometry.invert(X)
    report = {'ok': geometry.quality_ok(residuals) and all(v['ok'] for v in fixed.values())
                    and all(s['detection']['reprojection_mean_px'] < 1 for s in samples),
              'installed': False, 'candidate_written': False, 'collection': str(collection),
              'board': settings,
              'method': 'training-only Brown5 color intrinsic fit and hand-eye; three reserved views',
              'intrinsics_training_rms_px': rms, 'K': K.tolist(), 'distortion_coeffs': D.ravel().tolist(),
              'T_cam_tcp': cam_tcp.tolist(), 'T_cam_flange': (cam_tcp@geometry.invert(F)).tolist(),
              'T_base_board': B.tolist(), 'fixed': fixed, 'residuals': residuals,
              'detections': [{'index': s['index'], 'held_out': s['held_out'], **s['detection']} for s in samples],
              'preflight': preflight}
    result_path = root/'result.json'
    result_path.write_text(json.dumps(report, indent=2)+'\n')
    if not report['ok']:
        raise ValueError('refined fit failed the original 5 mm / 1 degree or reprojection checks')
    candidate = root/'candidate'
    candidate.mkdir()
    configured = copy.deepcopy(options)
    source = {'method': report['method'], 'result': str(result_path), 'board': settings,
              'tcp_offset_mm_rad': offset, 'quality_check_passed': True}
    for camera in configured['cameras']:
        name = camera['name']
        camera.pop('calibration_native', None)
        camera.pop('calibration_raw_color', None)
        reference = json.loads(Path(camera['intrinsics']).read_text())
        reference.pop('metric_validation_source', None)
        if name == wrist:
            # A new color fit invalidates the previous stereo relationship.
            reference.pop('calibrated_depth_to_color', None)
            profiles = {}
            for key, profile in reference['color_profiles'].items():
                # The recorded factory models encode the profile's resize/crop.
                # Transfer that pixel-coordinate affine map, retaining the same
                # normalized-ray distortion; validate the runtime profile live.
                affine = np.asarray(profile['K'])@np.linalg.inv(factory)
                profiles[key] = {'width': profile['width'], 'height': profile['height'],
                                 'fps': profile['fps'], 'K': (affine@K).tolist(),
                                 'distortion_model': 'brown_conrady', 'distortion_coeffs': D.ravel().tolist(),
                                 'source_profile': f"{entry['width']}x{entry['height']}@{entry['fps']}",
                                 'profile_pixel_affine': affine.tolist()}
            reference.update(calibrated_color_profiles=profiles, calibrated_source=source,
                             runtime_rectification='RGB rectified to fitted K; native depth projected with depth-to-color extrinsics and fitted K',
                             validation='training and reserved pose checks passed; runtime RGB-D verification pending')
        intrinsics = candidate/f'{name}_intrinsics.json'
        intrinsics.write_text(json.dumps(reference, indent=2)+'\n')
        extrinsics = candidate/(f'{name}_T_cam_tcp.yaml' if name == wrist else f'{name}_T_cam_base.yaml')
        geometry.write_matrix(extrinsics, cam_tcp if name == wrist else fixed[name]['T_cam_base'], source)
        camera.update(intrinsics=str(intrinsics), extrinsics=str(extrinsics))
    geometry.write_matrix(candidate/f'{wrist}_T_cam_flange.yaml', report['T_cam_flange'], source)
    (root/'backend-options.json').write_text(json.dumps(configured, indent=2)+'\n')
    report['candidate_written'] = True
    result_path.write_text(json.dumps(report, indent=2)+'\n')
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--collection', type=Path, required=True)
    parser.add_argument('--root', type=Path, required=True)
    parser.add_argument('--backend-options', type=Path, default=PROJECT/'examples/xarm-wuji.json')
    args = parser.parse_args()
    root = args.root.resolve()
    if not root.is_relative_to(artifact_root()):
        raise SystemExit('output root must be inside RAX_ARTIFACT_ROOT')
    root.mkdir(parents=True, exist_ok=False)
    report = fit(args.collection.resolve(), root, json.loads(args.backend_options.read_text()))
    print(json.dumps({k: report[k] for k in ('ok', 'candidate_written', 'intrinsics_training_rms_px', 'residuals')}, indent=2))


if __name__ == '__main__':
    main()
